# ---- Core ----
# PostgreSQL connection string. For local development `npm run db:start` serves the URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/aurelle?schema=public"
# Public base URL of the site (used for canonical URLs, sitemap, Open Graph, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Long random string used to sign guest cookies and tokens. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# ---- Payments: Razorpay (test mode keys start with rzp_test_) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Development only: allows a clearly-labelled simulated test payment when Razorpay keys are missing.
# Ignored when NODE_ENV=production.
DEV_PAYMENT_SIMULATOR="true"

# ---- Email (optional). Without SMTP, emails are written to the server log in development. ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Aurelle Jewellery <no-reply@example.com>"
# Require customers to verify email before checkout ("true"/"false")
REQUIRE_EMAIL_VERIFICATION="false"

# ---- Image storage ----
# "local" stores uploads in public/uploads (single server only).
# "s3" uploads to any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces...).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Local dev database runner (npm run db:start) ----
DEV_DB_PORT="5433"
